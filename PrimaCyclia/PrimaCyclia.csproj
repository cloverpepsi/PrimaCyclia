<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <RootNamespace />
	  <AssemblyName>PrimaCyclia</AssemblyName>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
    
	<PropertyGroup>
		<!-- Path to Opus Magnum folder, Contains Lightning.exe et.al -->
		<OpusDir>C:\Program Files (x86)\Steam\steamapps\common\Opus Magnum\modded</OpusDir>
	</PropertyGroup>

  <ItemGroup>
	<Reference Include="DevLightning">
	<HintPath>$(OpusDir)\DevLightning.dll</HintPath>
	<Private>false</Private>
	<CopyLocal>False</CopyLocal>
	</Reference>
  <Reference Include="Mono.Cecil">
	<HintPath>$(OpusDir)\Mono.Cecil.dll</HintPath>
	<CopyLocal>False</CopyLocal>
  </Reference>
  <Reference Include="MonoMod">
	<HintPath>$(OpusDir)\MonoMod.Patcher.dll</HintPath>
	<CopyLocal>False</CopyLocal>
  </Reference>
  <Reference Include="MonoMod.Utils">
	<HintPath>$(OpusDir)\MonoMod.Utils.dll</HintPath>
	<CopyLocal>False</CopyLocal>
  </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Content\tags\" />
  </ItemGroup>

</Project>
